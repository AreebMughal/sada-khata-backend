npx --no -- commitlint --edit "$1" || {
  echo
  echo -e "\033[1;31m🚨 Commit message does not follow the correct pattern! 🚨\033[0m"
  echo
  echo -e "\033[1mCommit message must follow this format:\033[0m"
  echo -e "  \033[1;33m<type>: <heading>\033[0m"
  echo
  echo -e "\033[1mBody (mandatory, must follow a blank line):\033[0m"
  echo -e "  \033[1;33m<description>\033[0m"
  echo
  echo -e "\033[1mFooter (mandatory, must include a ClickUp link):\033[0m"
  echo -e "  \033[1;33mhttps://app.clickup.com/t/<task-id>\033[0m"
  echo
  echo -e "\033[1mExamples:\033[0m"
  echo -e "  \033[1;32mfeat: add user authentication\033[0m"
  echo
  echo -e "  \033[1;33mImplemented JWT-based authentication for users.\033[0m"
  echo
  echo -e "  \033[1;33mhttps://app.clickup.com/t/abc123\033[0m"
  echo
  echo -e "\033[1mValid types:\033[0m \033[1;36mwip, feat, cr, hotfix, bugfix, refactor, format, devex, test, docs\033[0m"
  echo
  exit 1
}
